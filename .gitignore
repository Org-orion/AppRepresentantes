# Claude Code local settings (may contain API keys / command history)
.claude/

# Temp / data files
ctempprods.json
*.temp.json

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Environment variables — NEVER commit these
.env
.env.local
.env.*.local
.env.production
.env.staging

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Dumps de banco — contêm dados pessoais. NUNCA versionar.
backup-*.sql
*.dump
dump-*.sql

# Configuração local da rotina de backup — caminhos da máquina, e aponta para os
# arquivos de segredo (pgpass, passphrase do GPG). O modelo versionado é o
# backup.config.sample.psd1.
scripts/backup/backup.config.psd1
scripts/backup/*.local.*

# Supabase CLI local state
supabase/.temp/
